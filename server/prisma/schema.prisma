generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Item {
  id           String   @id @default(cuid())
  title        String
  domain       String
  url          String   @default("")
  date         String
  readingTime  String   @default("5 min read")
  image        String?
  summary      String   @default("[]")
  actionItems  String   @default("[]")
  quiz         String   @default("[]")
  status       String   @default("unread")
  xpAwarded    Boolean  @default(false)
  quizMastered Boolean  @default(false)
  tags         String   @default("[]")
  favorite     Boolean  @default(false)
  archived     Boolean  @default(false)
  sourceType   String   @default("link")
  review       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserState {
  id               Int     @id @default(1)
  xp               Int     @default(450)
  level            Int     @default(5)
  totalRead        Int     @default(0)
  totalQuizMastered Int    @default(0)
  totalQuizFailed  Int     @default(0)
  streak           Int     @default(0)
  lastActiveDate   String  @default("")
}

model TagInfo {
  id    String @id
  name  String
  color String
}

model Achievement {
  id          String  @id
  title       String
  description String
  icon        String
  unlocked    Boolean  @default(false)
  unlockedAt  String?
}

model DailyQuest {
  id          String  @id
  title       String
  description String
  target      Int
  progress    Int     @default(0)
  xpReward    Int
  completed   Boolean @default(false)
}

model ReviewLog {
  id        String   @id @default(cuid())
  itemId    String
  grade     Int
  easeBefore Float
  easeAfter  Float
  intervalBefore Int
  intervalAfter  Int
  date      String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  nickname     String   @unique
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
}
